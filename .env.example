# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill it in for local development.
# On Render you never create this file: the platform injects the values.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical links, sitemap, RSS and OG images.
# Local dev:      http://localhost:3000
# Production:     https://your-service.onrender.com  (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set to "1" to hide posts/projects flagged with `draft: true`.
# Drafts are always hidden in production builds.
# NEXT_PUBLIC_SHOW_DRAFTS=0
